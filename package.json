{
  "name": "datenwerkstatt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "test:unit": "vitest run",
    "test:integration": "playwright test --project=chromium tests/integration",
    "build": "npm run assets:prepare && vite build && node scripts/license-inventory.mjs",
    "test:e2e": "playwright test --project=chromium tests/e2e",
    "test:browser-matrix": "playwright test tests/integration",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:integration && npm run test:e2e",
    "test:deployment": "playwright test -c playwright.deploy.config.ts",
    "postinstall": "node scripts/patch-sqlrooms.mjs",
    "test:resources": "playwright test --project=chromium tests/benchmarks"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@noble/hashes": "2.0.1",
    "@sqlrooms/duckdb": "0.28.0",
    "@sqlrooms/room-store": "0.28.0",
    "@tanstack/react-router": "1.170.41",
    "apache-arrow": "17.0.0",
    "dexie": "4.4.6",
    "monaco-editor": "0.55.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-resizable-panels": "3.0.6",
    "webr": "0.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "overrides": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "dompurify": "3.4.16",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "qs": "6.16.0",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.12.0",
    "jsdom": "29.1.1",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.1.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=11 <12"
  }
}
